# Sentinel Risk Engine - Environment Configuration Example

# Server Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database Configuration (Production: postgresql, Dev: duckdb)
DB_ENGINE_TYPE=postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_secure_password_2026
DATABASE_URL=postgresql://sentinel_user:sentinel_secure_password_2026@postgres:5432/fraud_detection

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pipeline Configuration
BATCH_SIZE=1000
MAX_RETRIES=3
